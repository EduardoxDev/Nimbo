{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbo",
  "version": "0.9.0",
  "identifier": "com.nimbo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nimbo",
        "width": 820,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "translation",
        "title": "Nimbo · Tradução",
        "url": "index.html?window=translation",
        "width": 480,
        "height": 640,
        "minWidth": 480,
        "minHeight": 380,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "EduardoxDev",
    "copyright": "© 2026 EduardoxDev. Baseado no fly-island (MIT).",
    "category": "Utility",
    "shortDescription": "Uma ilha flutuante no topo do Windows",
    "longDescription": "Nimbo: música, tarefas, foco, água, casa e agentes de IA numa ilha flutuante no topo da tela.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4RjREN0FDOTdBRDJCNDYKUldSR0s2MlhyTmYwR05RemhoT29NZE1WZnFUVG9pWVNtRjU5eTQrNVp0U1RndTVtVStXbXRzN1MK",
      "endpoints": [
        "https://github.com/EduardoxDev/Nimbo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
